# انسخ هذا الملف إلى .env واملأ القيم محلياً. لا تضع كلمة المرور هنا.
PORT=3001
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=afiyah_test
DB_USER=afiyah_app
# اتركها فارغة إن كان الاتصال المحلي لا يتطلب كلمة مرور
DB_PASSWORD=

# سرّ توقيع JWT (32 حرفاً على الأقل). ولّده محلياً ولا تضعه هنا
JWT_SECRET=
# اختياري: أصول الواجهة المسموحة لطلبات التعديل، مفصولة بفواصل (الافتراضي خارج الإنتاج: خادم Vite المحلي)
# ALLOWED_ORIGINS=http://localhost:5173

# اختياري: بريد نموذج «تواصل معنا». اتركها كلها فارغة لتعطيله (يردّ المسار 503)؛ وإن ملئ بعضها وجب ملؤها كلها وإلا فشل الإقلاع.
# النقل المشفّر إلزامي: المنفذ 465 يستعمل TLS ضمنياً، وأي منفذ آخر (مثل 587) يشترط STARTTLS. لا تضع قيماً حقيقية في هذا الملف؛ تُوضع في .env المحلي فقط.
# SMTP_FROM: عنوان المُرسِل (حساب SMTP نفسه)؛ CONTACT_RECIPIENT: صندوق الإدارة المستقبِل.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_RECIPIENT=

# سكربت npm run admin:create (يُنفَّذ يدوياً مرة واحدة): ADMIN_EMAIL اختياري ويمكن تمريره وسيطاً بدلاً منه. كلمة المرور تُدخل في موجِّه مخفي ولا تُخزَّن هنا.
# ADMIN_EMAIL=
